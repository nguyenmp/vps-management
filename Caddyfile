# Redirects
origin.href.cat, docker.localhost {
    redir https://aggressivelyparaphrasing.me{uri} temporary
    header Cache-Control no-store
}

origin.status.href.cat, status.docker.localhost {
    redir https://stats.uptimerobot.com/ZM36nymMTx{uri} temporary
    header Cache-Control no-store
}

# Services
origin.hikariita.href.cat, hikariita.docker.localhost {
    reverse_proxy hikariita:80
}

simplearchive.href.cat, simplearchive.docker.localhost {
    @notGetHead {
        not method GET HEAD
    }
    basic_auth @notGetHead {
        admin {$SIMPLEARCHIVE_PASSWORD_HASH}
    }
    reverse_proxy simplearchive:8080
}

origin.static.href.cat, static.docker.localhost {
    reverse_proxy nginx:80
}

origin.changes.href.cat, changes.docker.localhost {
    reverse_proxy changedetection:5000
}

origin.recipes.href.cat, recipes.docker.localhost {
    reverse_proxy recipes:3000
}

