porter.href.cat, porter.docker.localhost {
    # Basic auth protects both the web UI and the API. The browser caches the
    # credentials and reuses them for the same-origin SSE stream automatically.
    basic_auth {
        porter {$PORTER_PASSWORD_HASH}
    }
    reverse_proxy porter:8787 {
        flush_interval -1   # required — the chat UI streams via htmx-SSE
    }
}
